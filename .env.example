# Copy to .env.local for local builds. In CI these come from GitHub repository
# *variables* (Settings > Secrets and variables > Actions > Variables).

# AdMob ad unit ids (leave empty to use Google's test ads)
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=

# Optional community server (server/README.md): public build rooms,
# email-verified Free Chat and room signalling. Empty = those features are hidden.
VITE_SERVER_URL=

# Online rooms signalling server (empty = the community server above, else the free PeerJS cloud)
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_KEY=
VITE_PEER_SECURE=
# Optional TURN relay for players behind strict mobile networks
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Where Settings > Privacy Policy links to
VITE_PRIVACY_URL=
VITE_SUPPORT_EMAIL=
