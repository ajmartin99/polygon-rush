{
  "name": "polygon-rush-server",
  "private": true,
  "version": "1.0.0",
  "description": "Optional community server for Polygon Rush: room signalling, public build rooms, email-verified accounts and moderated Free Chat.",
  "type": "module",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "nodemailer": "10.0.12",
    "peer": "^1.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3"
  }
}
